# Base URL used when generating QR codes.
# Encoded format: ${QR_BASE_URL}/p/{slug}
# Example: https://jdseeds.in
QR_BASE_URL=https://jdseeds.in

# Contact form email (SMTP)
# Provide your SMTP provider details (Zoho, Gmail, SendGrid SMTP, etc.)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# Where contact form submissions should be delivered
CONTACT_TO_EMAIL=contact@jdseeds.in

# From address shown in the delivered email (must be allowed by SMTP provider)
CONTACT_FROM_EMAIL=no-reply@jdseeds.in

# Optional: prefix for subject line
CONTACT_SUBJECT_PREFIX=[JD SEEDS]

